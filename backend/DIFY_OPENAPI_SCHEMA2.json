  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API Key for authentication. Default: dify-map-agent-key-2024"
      }
    },
    "schemas": {
      "StandardResponse": {
        "type": "object",
        "description": "统一的响应结构，便于 LLM 记忆状态",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "操作是否成功",
            "example": true
          },
          "data": {
            "type": "object",
            "description": "操作结果数据，结构固定",
            "properties": {
              "id": {
                "type": "string",
                "description": "资源ID（如 marker_id, drawing_id, measurement_id），便于后续操作",
                "example": "marker_abc123"
              },
              "name": {
                "type": "string",
                "description": "资源名称",
                "example": "天安门广场"
              },
              "coordinate": {
                "type": "array",
                "description": "坐标 [经度, 纬度]",
                "items": {
                  "type": "number"
                },
                "example": [
                  116.3974,
                  39.9093
                ]
              },
              "type": {
                "type": "string",
                "description": "资源类型（marker, drawing, measurement, layer）",
                "example": "marker"
              },
              "value": {
                "type": "string",
                "description": "值（用于测量结果）",
                "example": "1.40 km"
              }
            }
          },
          "metadata": {
            "type": "object",
            "description": "元数据，包含便于后续操作的信息",
            "properties": {
              "marker_ids": {
                "type": "array",
                "description": "所有标记点ID列表",
                "items": {
                  "type": "string"
                },
                "example": [
                  "marker_1",
                  "marker_2"
                ]
              },
              "drawing_ids": {
                "type": "array",
                "description": "所有绘制图形ID列表",
                "items": {
                  "type": "string"
                },
                "example": [
                  "drawing_1"
                ]
              },
              "measurement_ids": {
                "type": "array",
                "description": "所有测量结果ID列表",
                "items": {
                  "type": "string"
                },
                "example": [
                  "measurement_1"
                ]
              },
              "current_layer": {
                "type": "string",
                "description": "当前地图图层类型",
                "enum": [
                  "osm",
                  "satellite",
                  "terrain"
                ],
                "example": "osm"
              }
            }
          },
          "message": {
            "type": "string",
            "description": "操作结果消息",
            "example": "已在天安门广场添加标记点"
          }
        },
        "required": [
          "success"
        ]
      }
    }
  }
