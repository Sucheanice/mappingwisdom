# ============================================
# 项目环境变量配置示例
# ============================================
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件不会被提交到 Git 仓库

# ============================================
# 基础配置
# ============================================
PROJECT_NAME=MappingWisdom
ENVIRONMENT=local
DOMAIN=localhost
STACK_NAME=mappingwisdom

# ============================================
# 安全密钥（必须修改！）
# ============================================
# 生成密钥命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
# 认证开关（暂时禁用，方便开发。设置为 true 启用认证）
AUTH_ENABLED=false

# ============================================
# 前端配置
# ============================================
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 前端环境变量（Vite 需要 VITE_ 前缀）
VITE_API_URL=http://localhost:8000
VITE_AMAP_API_KEY=your-amap-api-key-here
# 认证开关（暂时禁用，方便开发。设置为 true 启用认证）
VITE_AUTH_ENABLED=false

# ============================================
# PostgreSQL 数据库配置
# ============================================
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=app

# ============================================
# MySQL 数据库配置
# ============================================
MYSQL_SERVER=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=changethis
MYSQL_DB=mappingwisdom

# ============================================
# 邮件服务配置（可选）
# ============================================
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=

# ============================================
# 第三方服务配置
# ============================================
# 高德地图 API Key（用于天气、地理编码等服务）
AMAP_API_KEY=your-amap-api-key-here

# Dify AI 配置（可选，用于对话式地图操作代理）
DIFY_API_BASE=https://api.dify.ai
DIFY_API_KEY=your-dify-api-key-here
DIFY_APP_ID=

# 地图 Agent API 配置（用于 Dify 工具集成）
MAP_AGENT_API_BASE=http://localhost:8000
MAP_AGENT_API_KEY=changethis

# 短信服务配置（可选）
SMS_ACCOUNT=your-sms-account
SMS_PASSWORD=your-sms-password

# ============================================
# 监控和错误追踪（可选）
# ============================================
SENTRY_DSN=

